[
  {
    "id": "cinemaTmdb000001",
    "name": "TMDB",
    "type": "httpBearerAuth",
    "data": { "token": << tmdb_api_key | to_json >> }
  },
  {
    "id": "cinemaOmdb000001",
    "name": "OMDb",
    "type": "httpQueryAuth",
    "data": { "name": "apikey", "value": << omdb_api_key | to_json >> }
  },
  {
    "id": "healthWebhook001",
    "name": "Health webhook secret",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Health-Secret", "value": << health_webhook_secret | to_json >> }
  },
  {
    "id": "healthGithub0001",
    "name": "GitHub health",
    "type": "httpBearerAuth",
    "data": { "token": << health_github_token | to_json >> }
  }
]
