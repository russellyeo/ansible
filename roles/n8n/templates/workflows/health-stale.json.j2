{%- set lib = lookup('file', 'health/health.js') ~ '\n' -%}
{
  "id": "healthStale00001",
  "name": "Health: alert when payloads stop",
  "active": true,
  "settings": { "executionOrder": "v1", "availableInMCP": true, "timezone": "Europe/London", "errorWorkflow": "ccfmError0000001" },
  "nodes": [
    {
      "id": "stale-schedule",
      "name": "Daily 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 10 * * *" }] } }
    },
    {
      "id": "stale-read",
      "name": "Read last payload",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": { "fileSelector": "/home/node/health-raw/last-payload.json", "options": {} }
    },
    {
      "id": "stale-extract",
      "name": "Extract",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [440, 0],
      "parameters": { "operation": "fromJson", "binaryPropertyName": "data", "destinationKey": "data", "options": {} }
    },
    {
      "id": "stale-check",
      "name": "Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": { "jsCode": << (lib ~ lookup('file', 'health/nodes/stale.js')) | to_json >> }
    },
    {
      "id": "stale-if",
      "name": "Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "is-stale", "leftValue": "={{ $json.stale }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "stale-email",
      "name": "Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "position": [1100, -100],
      "parameters": {
        "sendTo": "<< ccfm_email_to >>",
        "subject": "=No Health Auto Export payload for {{ $json.days }} days",
        "emailType": "text",
        "message": "=The health vault hasn't had a payload from Health Auto Export for {{ $json.days }} days.\n\nCheck on the iPhone that:\n- the \"n8n metrics\" and \"n8n workouts\" automations are still on\n- Health Auto Export Premium is active (the REST API stops when the trial ends)\n- the phone can reach n8n (at home, or on Tailscale)",
        "options": { "appendAttribution": false }
      },
      "credentials": { "gmailOAuth2": { "id": "<< n8n_gmail_credential_id >>", "name": "Gmail" } }
    }
  ],
  "connections": {
    "Daily 10:00": { "main": [[{ "node": "Read last payload", "type": "main", "index": 0 }]] },
    "Read last payload": { "main": [[{ "node": "Extract", "type": "main", "index": 0 }]] },
    "Extract": { "main": [[{ "node": "Check", "type": "main", "index": 0 }]] },
    "Check": { "main": [[{ "node": "Stale?", "type": "main", "index": 0 }]] },
    "Stale?": { "main": [[{ "node": "Email", "type": "main", "index": 0 }], []] }
  },
  "pinData": {}
}
