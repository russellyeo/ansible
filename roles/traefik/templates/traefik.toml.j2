[global]
  checkNewVersion = false
  sendAnonymousUsage = false

[log]
  level = "{{ log_level }}"

[accessLog]
  filePath = "/etc/traefik/access.log"

[api]
  dashboard = true
  insecure = true

[entryPoints]
  # home.arpa stays on plain HTTP; *.{{ traefik_public_domain }} is redirected
  # to websecure (dynamic/https.toml).
  [entryPoints.web]
    address = ":80"

  [entryPoints.websecure]
    address = ":443"
    [entryPoints.websecure.http.tls]
      certResolver = "letsencrypt"
      [[entryPoints.websecure.http.tls.domains]]
        main = "*.{{ traefik_public_domain }}"

# Wildcard certificates need the DNS challenge: Traefik writes a TXT record
# through the Cloudflare API (CF_DNS_API_TOKEN), so nothing is opened to the
# internet.
[certificatesResolvers.letsencrypt.acme]
  storage = "/acme/acme.json"
{% if traefik_acme_staging %}
  caServer = "https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
  [certificatesResolvers.letsencrypt.acme.dnsChallenge]
    provider = "cloudflare"
    resolvers = ["1.1.1.1:53", "1.0.0.1:53"]

[providers]
  [providers.docker]
    endpoint = "tcp://docker-socket-proxy:{{ docker_socket_proxy_port }}"
    exposedByDefault = false
    network = "{{ docker_network }}"
    watch = true

  # Host-networked containers (e.g. Plex) cannot be routed by the docker
  # provider: with network_mode host it has no container IP to discover and
  # falls back to 127.0.0.1, which is Traefik itself. Those get an explicit
  # backend URL here instead.
  [providers.file]
    directory = "/etc/traefik/dynamic"
    watch = true

# Dashboard accessible at http://{{ traefik_ip }}:8080
# Services accessible at http://<service>.{{ traefik_home_domain }}
# and https://<service>.{{ traefik_public_domain }}
