[global]
  checkNewVersion = false
  sendAnonymousUsage = false

[log]
  level = "{{ log_level }}"

[accessLog]
  filePath = "/etc/traefik/access.log"

[api]
  dashboard = true
  insecure = true

[entryPoints]
  [entryPoints.web]
    address = ":80"

[providers]
  [providers.docker]
    endpoint = "tcp://docker-socket-proxy:{{ docker_socket_proxy_port }}"
    exposedByDefault = false
    network = "{{ docker_network }}"
    watch = true

  # Host-networked containers (e.g. Plex) cannot be routed by the docker
  # provider: with network_mode host it has no container IP to discover and
  # falls back to 127.0.0.1, which is Traefik itself. Those get an explicit
  # backend URL here instead.
  [providers.file]
    directory = "/etc/traefik/dynamic"
    watch = true

# Dashboard accessible at http://{{ traefik_ip }}:8080
# Services accessible at http://<service>.{{ traefik_home_domain }}
